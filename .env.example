APP_NAME=Miru API
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://miru:miru_password@localhost:5432/miru

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

JOURNAL_ANALYZER_PROVIDER=keyword
JOURNAL_ANALYZER_FALLBACK_PROVIDER=keyword
JOURNAL_ANALYZER_DEBUG=false

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=mistralai/mistral-medium-3.5-128b
NVIDIA_NIM_TIMEOUT_SECONDS=30
NVIDIA_NIM_MAX_TOKENS=1200
