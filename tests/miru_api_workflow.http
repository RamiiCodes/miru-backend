GET {{baseUrl}}/state


###
GET {{baseUrl}}/user-context


###
PUT {{baseUrl}}/user-context
Content-Type: application/json

{
  "age_range_min": 30,
  "age_range_max": 35,
  "country": "France",
  "work_situation": "employed",
  "relationship_status": "single",
  "family_support_score": 6,
